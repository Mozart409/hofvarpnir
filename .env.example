# Database Configuration
# For local development with Docker Compose, use PgBouncer
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/hofvarpnir_dev

# Direct Postgres connection (for migrations only)
# SQLx migrations cannot run through PgBouncer in transaction mode
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hofvarpnir_dev

# Server Configuration
HOST=127.0.0.1
PORT=8080

# Download Configuration
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_HOURS=4
MAX_DOWNLOAD_ATTEMPTS=5

# Rate Limiting
RATE_LIMIT_DELAY_SECS=5

# Storage
DEFAULT_OUTPUT_DIR=/var/lib/hofvarpnir/downloads

# Logging
RUST_LOG=info,hofvarpnir=debug,sqlx=warn

# Optional: Override for production
# DATABASE_URL=postgresql://user:pass@pgbouncer-host:6432/hofvarpnir
# DATABASE_DIRECT_URL=postgresql://user:pass@postgres-host:5432/hofvarpnir
