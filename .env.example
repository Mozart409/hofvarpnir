# Database Configuration
# Direct connection to PostgreSQL with SQLx built-in connection pooling
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hofvarpnir_dev

# Server Configuration
HOST=127.0.0.1
PORT=8080
# Base URL for OpenAPI docs (used in Scalar curl examples)
API_BASE_URL=http://localhost:8080

# Download Configuration
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_HOURS=4
MAX_DOWNLOAD_ATTEMPTS=5

# Rate Limiting
RATE_LIMIT_DELAY_SECS=60
# Storage
DEFAULT_OUTPUT_DIR=/var/lib/hofvarpnir/downloads

# Logging
RUST_LOG=info,hofvarpnir=debug,sqlx=warn
# LOG_FORMAT=json  # Set to "json" for structured JSON output (default: text)

# Metrics
# METRICS_ENABLED=true  # Prometheus /metrics endpoint (default: true)

# OpenTelemetry — set endpoint to enable OTLP trace export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=hofvarpnir

# Loki — set LOKI_URL to enable log shipping to Grafana Loki
# LOKI_URL=http://localhost:3100

# Optional: Override for production
# DATABASE_URL=postgresql://user:pass@postgres-host:5432/hofvarpnir
#
# YTDLP_PATH=/path/to/yt-dlp


