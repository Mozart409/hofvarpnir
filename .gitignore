result
target/
.direnv/

.env

# SQLx - commit the workspace-wide offline query metadata at the repo root
# (generated by `just prepare`, i.e. `cargo sqlx prepare --workspace`).
# Ignore stray per-crate .sqlx/ dirs so only the root one is tracked.
crates/*/.sqlx/

.claude/
/result-ffmpeg-bin
/result-ffmpeg-man
/result-ytdlp

docs/superpowers/

# Claude Code sandbox: bubblewrap masks these paths with /dev/null bind mounts,
# which show up as untracked character devices inside the sandbox only.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
# Unanchored: the sandbox also masks this in whatever subdirectory a command
# runs from (e.g. crates/hof-web/.mcp.json). `.claude/` above already matches
# at any depth.
.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc
