# Database Configuration
# Direct connection to PostgreSQL with SQLx built-in connection pooling
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hofvarpnir_dev

# Server Configuration
HOST=127.0.0.1
PORT=8080

# Download Configuration
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_HOURS=4
MAX_DOWNLOAD_ATTEMPTS=5

# Rate Limiting
RATE_LIMIT_DELAY_SECS=60
# Storage
DEFAULT_OUTPUT_DIR=/var/lib/hofvarpnir/downloads

# Logging
RUST_LOG=info,hofvarpnir=debug,sqlx=warn

# Optional: Override for production
# DATABASE_URL=postgresql://user:pass@postgres-host:5432/hofvarpnir
#
# YTDLP_PATH=/path/to/yt-dlp

# OIDC Authentication (optional - disabled if OIDC_ISSUER not set)
# Supports any OIDC-compliant provider: Keycloak, Auth0, Azure AD, Google, Okta, Pocket-ID, etc.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=hofvarpnir
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_SCOPES=openid,profile,email           # Default: openid profile email
# OIDC_AUTO_PROVISION=true                   # Create user on first OIDC login (default: true)
# OIDC_REDIRECT_BASE_URL=https://hof.example.com  # Override callback URL base
# OIDC_LOGOUT_REDIRECT=false                 # Redirect to provider on logout (default: false)
# OIDC_DISCOVERY_TIMEOUT=30                  # Discovery HTTP timeout in seconds (default: 30)

